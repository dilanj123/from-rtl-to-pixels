 x="420" y="40" width="270" height="75" as="geometry" /></mxCell><mxCell id="alt" value="&lt;b&gt;A and B are alternative top-level implementations.&lt;/b&gt;&lt;br&gt;The dashed branch shows the one controlled B difference; both use the same final 11-bit output buffer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9aa6b2;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="40" width="650" height="75" as="geometry" /></mxCell><mxCell id="drain" value="No frame overlap during drain. FRAME_COUNT increments only when the externally visible final tagged token transfers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9aa6b2;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1560" y="610" width="600" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>