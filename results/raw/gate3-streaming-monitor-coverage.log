+ def targets(self):
+  if self.mode=='metadata': return {i:2 for i in [0]+list(range(W-1,N,W))}
+  if self.mode=='drain': return {i:(4 if i==N-1 else 3 if i==N-D else 1) for i in range(N-D,N)}
+  return {}
