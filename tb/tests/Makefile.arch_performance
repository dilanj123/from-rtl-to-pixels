TOPLEVEL_LANG = verilog
SIM ?= verilator
THIS_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
ROOT := $(abspath $(THIS_DIR)/../..)
IMG_WIDTH ?= 640
IMG_HEIGHT ?= 480
DUT_TOP ?= rtl_to_pixels_top
TOP_FILE ?= rtl/rtl_to_pixels_top.sv
export IMG_WIDTH IMG_HEIGHT PERF_JSON
VERILOG_SOURCES = $(ROOT)/rtl/pixel_pkg.sv $(ROOT)/rtl/rgb_to_gray.sv $(ROOT)/rtl/elastic_stage.sv $(ROOT)/rtl/apb_regs.sv $(ROOT)/rtl/pixel_control.sv $(ROOT)/rtl/line_buffer.sv $(ROOT)/rtl/window_3x3.sv $(ROOT)/rtl/sobel_compact.sv $(ROOT)/rtl/magnitude_clamp.sv $(ROOT)/rtl/threshold_stage.sv $(ROOT)/rtl/output_control.sv $(ROOT)/$(TOP_FILE)
TOPLEVEL = $(DUT_TOP)
COCOTB_TEST_MODULES = test_arch_performance
COMPILE_ARGS += -GIMG_WIDTH=$(IMG_WIDTH) -GIMG_HEIGHT=$(IMG_HEIGHT)
export PYTHONPATH := $(ROOT):$(THIS_DIR):$(PYTHONPATH)
include $(shell cocotb-config --makefiles)/Makefile.sim
