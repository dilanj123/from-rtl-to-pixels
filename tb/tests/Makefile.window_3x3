TOPLEVEL_LANG = verilog
SIM ?= verilator

THIS_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
ROOT := $(abspath $(THIS_DIR)/../..)

IMG_WIDTH ?= 5
IMG_HEIGHT ?= 4

export IMG_WIDTH
export IMG_HEIGHT

VERILOG_SOURCES = $(ROOT)/rtl/window_3x3.sv

TOPLEVEL = window_3x3
COCOTB_TEST_MODULES = test_window_3x3

COMPILE_ARGS += \
	-GIMG_WIDTH=$(IMG_WIDTH) \
	-GIMG_HEIGHT=$(IMG_HEIGHT)

export PYTHONPATH := $(ROOT):$(THIS_DIR):$(PYTHONPATH)

include $(shell cocotb-config --makefiles)/Makefile.sim
